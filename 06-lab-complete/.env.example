# ============================================================
# Mẫu biến môi trường — KHÔNG ghi secret thật vào file này.
# Dùng:  cp .env.example .env   (file .env đã nằm trong .gitignore, không commit)
# Trên Railway / Render: đặt các biến này trong dashboard của nền tảng.
# ============================================================

# --- Server ---
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Bảo mật ---
# Client phải gửi header  X-API-Key: <giá trị này>.  Hãy đặt chuỗi dài, ngẫu nhiên, ví dụ:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=change-me
# Số request tối đa / 60 giây cho mỗi API key (vượt → 429)
RATE_LIMIT_PER_MINUTE=10

# --- Redis (rate limit + cost guard) ---
# Chạy local:           redis://localhost:6379/0
# Docker Compose:       redis://redis:6379/0   (compose tự đặt, không cần sửa)
# Railway / Render:     dùng URL của Redis do nền tảng cấp
REDIS_URL=redis://localhost:6379/0

# --- Ngân sách LLM (USD) — vượt → 402 ---
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
